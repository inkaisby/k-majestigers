# ==============================================================================
# K-MAJESTIGERS & INKAI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Project Supabase: majestigers (Ref: ecmafwuuuviesytcnorv | Region: ap-northeast-2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE SUPABASE (POSTGRESQL 17 VIA PRISMA ORM)
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string
# PENTING: Ganti [YOUR-PASSWORD] dengan password database yang Anda buat saat inisialisasi project.

# Connection Pooling (Port 6543) - Wajib untuk backend production / serverless / cloud:
DATABASE_URL="postgresql://postgres.ecmafwuuuviesytcnorv:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Digunakan Prisma saat 'npx prisma migrate' / 'prisma db push':
DIRECT_URL="postgresql://postgres.ecmafwuuuviesytcnorv:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & CLOUD STORAGE
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API (Data API)
SUPABASE_URL="https://ecmafwuuuviesytcnorv.supabase.co"

# Kunci Publik (Aman diakses client / frontend):
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_ANON_KEY="sb_publishable_..."

# Kunci Rahasia Admin (HANYA untuk Backend - JANGAN PERNAH dibagikan ke client/frontend):
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://ecmafwuuuviesytcnorv.supabase.co/auth/v1/.well-known/jwks.json"

# ------------------------------------------------------------------------------
# 3. BACKEND API SERVER (inkai-backend: Node.js + Express)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Kunci rahasia untuk tanda tangan JWT Auth token (minimal 32 karakter acak yang kuat):
JWT_SECRET="k_majestigers_jwt_secret_production_2026_super_secure_key"

# Domain yang diizinkan mengakses backend (pisahkan dengan koma jika lebih dari satu):
# Pastikan URL Vercel produksi Anda terdaftar di sini untuk mencegah error CORS di browser.
CORS_ORIGIN="https://k-majestigers.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 4. FRONTEND VERCEL CONFIGURATION
# ------------------------------------------------------------------------------
# URL publik backend yang akan dihubungi oleh frontend di Vercel:
# Contoh jika backend di-host di Railway/Render/VPS:
API_URL="https://api.kmajestigers.com/api"

# ------------------------------------------------------------------------------
# 5. INTEGRASI EKSTERNAL (OPSIONAL - SESUAI PRD K-MAJESTIGERS)
# ------------------------------------------------------------------------------
# Rate Limiting & High-Concurrency Caching (Upstash Redis):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error Monitoring (Sentry):
SENTRY_DSN=""

# Payment Gateway (Midtrans - Transaksi Merchandise & Pendaftaran Kejuaraan):
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
